{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Buffs flying with an elytra: crouch for a few seconds to cold start into the air, and diving regains a little more speed, so a flight can go on forever.",
  "authors": [
    "Nico Welles"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.welles.elytrabuff.ElytraBuffFabric"
    ],
    "client": [
      "dev.welles.elytrabuff.ElytraBuffFabricClient"
    ],
    "modmenu": [
      "dev.welles.elytrabuff.ElytraBuffModMenu"
    ]
  },
  "mixins": [
    "elytrabuff.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
