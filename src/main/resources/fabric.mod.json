{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Buffs flying with an elytra: crouch to cold start into the air with one mighty wing beat, flap the wings in flight for extra speed, and regain more speed from diving, so a flight can go on forever.",
  "icon": "assets/${id}/icon.png",
  "authors": [
    "Nico Welles"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.welles.elytrabuff.ElytraBuffFabric"
    ],
    "client": [
      "dev.welles.elytrabuff.ElytraBuffFabricClient"
    ],
    "modmenu": [
      "dev.welles.elytrabuff.ElytraBuffModMenu"
    ]
  },
  "mixins": [
    "elytrabuff.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
